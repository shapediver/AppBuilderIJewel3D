{
	"compilerOptions": {
		"target": "es6",
		"types": ["vite/client", "vite-plugin-svgr/client", "node"],
		"paths": {
			"@AppBuilderShared/*": ["./src/shared/*"],
			"@AppBuilderLib/*": ["./src/shared/*"],
			"~/*": ["./src/*"],
			"@modelstorage": ["./modelstorage.ts"],
			"@webgi/*": ["./src/webgi/*"]
		},
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"noFallthroughCasesInSwitch": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"strictNullChecks": true
	},
	"include": ["src/AppBuilderRoot.tsx"],
	"exclude": [
		"**/*.test.ts",
		"**/*.test.tsx",
		"**/*.spec.ts",
		"**/*.spec.tsx"
	],
	"references": [{"path": "./tsconfig.jest.json"}]
}
